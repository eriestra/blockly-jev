{
  "name": "blockly-jev",
  "version": "0.1.0",
  "description": "Blockly extension: an if block backed by a TypeSafe Jev Noul and a switch block backed by a Jev Choice.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:proxy\" \"vite\"",
    "proxy": "node server/proxy.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "build:demo:almond": "VITE_JEV_RUNTIME=almond vite build --outDir ../demo-dist-almond",
    "test": "vitest run",
    "test:live": "JEV_LIVE=1 vitest run test/live-validate.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:bit": "node demo/bit/build-geometry.mjs && esbuild demo/bit/main.js --bundle --minify --format=iife --outfile=demo/bit/app.js",
    "test:bit": "node demo/bit/check-geometry.mjs && node demo/bit/check-question.mjs"
  },
  "keywords": [
    "blockly",
    "blockly-plugin",
    "typesafe",
    "jev",
    "system-one",
    "noul",
    "choice"
  ],
  "author": "Ernesto Riestra",
  "license": "MIT",
  "peerDependencies": {
    "blockly": ">=11.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "blockly": "^13.3.0",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^27.4.0",
    "three": "^0.186.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
