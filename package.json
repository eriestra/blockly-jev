{
  "name": "blockly-jev",
  "version": "0.1.0",
  "description": "Blockly extension: an if block backed by a TypeSafe Jev Noul and a switch block backed by a Jev Choice.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:proxy\" \"vite\"",
    "proxy": "node server/proxy.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "blockly",
    "blockly-plugin",
    "typesafe",
    "jev",
    "system-one",
    "noul",
    "choice"
  ],
  "author": "Ernesto Riestra",
  "license": "MIT",
  "peerDependencies": {
    "blockly": ">=11.0.0"
  },
  "devDependencies": {
    "blockly": "^13.3.0",
    "concurrently": "^9.1.2",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "@typesafe-ai/sdk": "^0.6.0"
  }
}
